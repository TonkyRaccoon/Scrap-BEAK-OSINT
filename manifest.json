{
  "manifest_version": 3,
  "name": "Scrap BEAK OSINT",
  "description": "OSINT & Cybersecurity toolkit — right-click to investigate IPs, domains, hashes, CVEs, and more.",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://ipinfo.io/*",
    "https://api.abuseipdb.com/*"
  ]
}
